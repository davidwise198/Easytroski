# ---------------------------------------------------------------------------
# Copy this file to supabase/.env.local and fill in your own values.
#
# supabase/.env.local is gitignored — it must never be committed, and the
# secret values must never be pasted into a chat or an issue.
#

# ─── Paystack ──────────────────────────────────────────────────────────────
# Start in test mode: sk_test_... Keep it out of the app entirely.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_ENV=test

# ─── Firebase service account (Firestore admin access) ─────────────────────
# Firebase Console → Project settings → Service accounts → Generate new key.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the \n escapes exactly as they appear in the JSON file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ─── Business rules (optional — defaults shown) ────────────────────────────
COMMISSION_RATE=0.10
HOLD_MINUTES=5
PAYMENT_WINDOW_MINUTES=5
PAYOUT_CUTOFF_HOUR=20
MIN_PAYOUT_PESEWAS=100
DRIVER_STALE_MINUTES=5
