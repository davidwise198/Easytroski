{
  "expo": {
    "name": "EasyTroski",
    "slug": "easytroski",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "easytroski",
    "description": "EasyTroski is a smart transport platform that connects passengers with available trotro vehicles, enabling convenient seat booking and real-time driver tracking.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F8FC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.easytroski.app"
    },
    "android": {
      "package": "com.easytroski.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
