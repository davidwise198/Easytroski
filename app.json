{
  "expo": {
    "name": "EasyTroski",
    "slug": "easytroski",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "scheme": "easytroski",
    "description": "EasyTroski is a smart transport platform that connects passengers with available trotro vehicles, enabling convenient seat booking and real-time driver tracking.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B2A4A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.easytroski.app"
    },
    "android": {
      "package": "com.easytroski.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B2A4A"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD8KYdnSnEnBWUAoKEwERH9pm4GQsXnyF4"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow EasyTroski to use your location to find nearby routes and drivers."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow EasyTroski to access your photos for profile pictures.",
          "cameraPermission": "Allow EasyTroski to take photos for your profile picture."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d5e25ccf-0029-42ba-89f1-6875153e590b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d5e25ccf-0029-42ba-89f1-6875153e590b"
    }
  }
}
