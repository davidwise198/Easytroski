rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ──────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    /** Ensure a string field exists and is not empty. */
    function fieldExists(field) {
      return request.resource.data.keys().hasAll([field])
        && request.resource.data[field] is string
        && request.resource.data[field] != "";
    }

    /** Reject documents larger than ~1 MiB (Firestore max is 1 MiB). */
    function reasonableSize() {
      return request.resource.data.size() < 1048576;
    }

    /** On update, ensure the user isn't changing the owner/creator field. */
    function ownerFieldUnchanged(fieldName) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([fieldName]);
    }

    // ─── Users ─────────────────────────────────────────────────────────

    match /users/{userId} {
      // Users can read and update their own profile; admins can read/write any.
      allow create: if isOwner(userId)
        && fieldExists("name")
        && fieldExists("email")
        && reasonableSize();
      // Read: owner and admin ONLY. Drivers see passenger names via the
      // passengerName field embedded on the booking — not by reading profiles.
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    // ─── Install sessions (one account, one device) ────────────────────
    //
    // Each device writes its session id here on sign-in; the newest device
    // overwrites the doc and older devices detect the mismatch and sign out.
    match /install-sessions/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // ─── Push tokens ───────────────────────────────────────────────────
    //
    // Tokens are credentials — they live in their own collection so that
    // sending a push never requires reading another user's profile.
    match /push-tokens/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && fieldExists("token")
        && reasonableSize();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ─── Routes (admin-managed) ────────────────────────────────────────

    match /routes/{routeId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && fieldExists("origin")
        && fieldExists("destination")
        && reasonableSize();
      allow update: if isAdmin()
        && reasonableSize();
      allow delete: if isAdmin();
    }

    // ─── Vehicles ──────────────────────────────────────────────────────

    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      // Only admin can create vehicles (prevents any user from registering a vehicle).
      allow create: if isAdmin()
        && fieldExists("numberPlate")
        // capacity is a number (seat count)
        && request.resource.data.capacity is number
        && reasonableSize();
      // Driver can update their own vehicle (e.g. set active status).
      // Admin can update any vehicle.
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.driverId == request.auth.uid
          && ownerFieldUnchanged("driverId")
          && ownerFieldUnchanged("numberPlate"));
      allow delete: if isAdmin();
    }

    // ─── Driver profiles ───────────────────────────────────────────────

    match /drivers/{driverId} {
      // Read: signed-in users can read driver profiles.
      allow read: if signedIn();

      // Create: only the driver themselves can create their own profile.
      allow create: if isOwner(driverId)
        && fieldExists("userId")
        && request.resource.data.userId == driverId
        && reasonableSize();

      // Update: driver can update their own profile; admin can update any.
      allow update: if isAdmin()
        || (isOwner(driverId)
          && ownerFieldUnchanged("userId")
          && ownerFieldUnchanged("licenseNumber")
          && reasonableSize())
        // Passengers adjusting seats after booking/cancelling, or submitting
        // a rating, may write ONLY these aggregate fields.
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["availableSeats", "rating"])
          && request.resource.data.get("availableSeats", 0) is number
          && request.resource.data.get("availableSeats", 0) >= 0
          && request.resource.data.get("rating", 0) is number
          && request.resource.data.get("rating", 0) >= 0
          && request.resource.data.get("rating", 0) <= 5
          && reasonableSize());

      allow delete: if isAdmin();
    }

    // ─── Passenger profiles ────────────────────────────────────────────

    match /passengers/{passengerId} {
      allow create: if isOwner(passengerId)
        && reasonableSize();
      allow read: if isOwner(passengerId) || isAdmin();
      allow update: if isOwner(passengerId) || isAdmin();
      allow delete: if false;
    }

    // ─── Trips ─────────────────────────────────────────────────────────

    match /trips/{tripId} {
      allow read: if signedIn();

      // Create: driver can only create trips for themselves.
      allow create: if signedIn()
        && request.resource.data.driverId == request.auth.uid
        && fieldExists("routeId")
        && fieldExists("status")
        && reasonableSize();

      // Update: driver can update their own trips; admin can update any.
      // The driverId and routeId cannot be changed after creation.
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.driverId == request.auth.uid
          && ownerFieldUnchanged("driverId")
          && ownerFieldUnchanged("routeId")
          && reasonableSize());

      allow delete: if isAdmin();
    }

    // ─── Bookings ──────────────────────────────────────────────────────

    match /bookings/{bookingId} {
      // Read: only the passenger who booked, the driver assigned, or admin.
      allow read: if signedIn()
        && (resource.data.passengerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || isAdmin());

      // Create: a signed-in user can create a booking only for themselves.
      allow create: if signedIn()
        && request.resource.data.passengerId == request.auth.uid
        && fieldExists("driverId")
        && fieldExists("routeId")
        // pickupLocation / dropOffLocation are objects ({latitude, longitude, address})
        && request.resource.data.pickupLocation is map
        && request.resource.data.dropOffLocation is map
        // A booking reserves between 1 and 3 seats
        && request.resource.data.get("seats", 1) >= 1
        && request.resource.data.get("seats", 1) <= 3
        && reasonableSize();

      // Update: passenger or driver can update their own bookings; admin can update any.
      allow update: if signedIn()
        && (resource.data.passengerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || isAdmin())
        && ownerFieldUnchanged("passengerId")
        && ownerFieldUnchanged("driverId")
        && ownerFieldUnchanged("routeId")
        && reasonableSize();

      // Delete: the passenger who booked can remove it from their history;
      // admins can delete any booking.
      allow delete: if isAdmin()
        || resource.data.passengerId == request.auth.uid;
    }

    // ─── Ratings ───────────────────────────────────────────────────────

    match /ratings/{ratingId} {
      // Read: any signed-in user (driver averages are public info).
      allow read: if signedIn();

      // Create: a signed-in user can submit a rating only for themselves.
      allow create: if signedIn()
        && request.resource.data.passengerId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && fieldExists("driverId")
        && fieldExists("tripId")
        && reasonableSize();

      // Ratings are immutable once submitted.
      allow update, delete: if isAdmin();
    }

    // ─── Driver locations (privacy-sensitive) ──────────────────────────
    //
    // Separate from driver profiles so we can apply stricter rules.
    // The service layer filters which locations are sent to passengers.

    match /driverLocations/{uid} {
      // Only the driver themselves can write their location.
      allow write: if isOwner(uid);

      // Read access: the driver themselves, OR any signed-in user.
      // NOTE: For stricter privacy in production, you could restrict reads
      // to passengers who have an active booking with this driver. This would
      // require a subcollection or a query-based approach since Firestore
      // rules don't support complex joins. The current approach relies on the
      // service layer to filter which driver locations are exposed to passengers.
      allow read: if signedIn();
    }
  }
}
