rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ──────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    /** Ensure a string field exists and is not empty. */
    function fieldExists(field) {
      return request.resource.data.keys().hasAll([field])
        && request.resource.data[field] is string
        && request.resource.data[field] != "";
    }

    /** Reject documents larger than ~1 MiB (Firestore max is 1 MiB). */
    function reasonableSize() {
      return request.resource.data.size() < 1048576;
    }

    /** On update, ensure the user isn't changing the owner/creator field. */
    function ownerFieldUnchanged(fieldName) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([fieldName]);
    }

    /** True when an update only touches fields in the given allowlist. */
    function changedKeysWithin(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ─── Users ─────────────────────────────────────────────────────────

    match /users/{userId} {
      // Users can read and update their own profile; admins can read/write any.
      allow create: if isOwner(userId)
        && fieldExists("name")
        && fieldExists("email")
        && reasonableSize();
      // Read: owner and admin ONLY. Drivers see passenger names via the
      // passengerName field embedded on the booking — not by reading profiles.
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    // ─── Install sessions (one account, one device) ────────────────────
    //
    // Each device writes its session id here on sign-in; the newest device
    // overwrites the doc and older devices detect the mismatch and sign out.
    match /install-sessions/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // ─── Push tokens ───────────────────────────────────────────────────
    //
    // Tokens are credentials — they live in their own collection so that
    // sending a push never requires reading another user's profile. The
    // backend reads them with admin privileges when it sends a notification.
    match /push-tokens/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && fieldExists("token")
        && reasonableSize();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ─── Routes (admin-managed) ────────────────────────────────────────
    //
    // `farePesewas` is the trusted price per seat: the backend reads it to work
    // out what a passenger owes, so only an admin may set it.

    match /routes/{routeId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && fieldExists("origin")
        && fieldExists("destination")
        && reasonableSize();
      allow update: if isAdmin()
        && reasonableSize();
      allow delete: if isAdmin();
    }

    // ─── Vehicles ──────────────────────────────────────────────────────

    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      // Only admin can create vehicles (prevents any user from registering a vehicle).
      allow create: if isAdmin()
        && fieldExists("numberPlate")
        // capacity is a number (seat count)
        && request.resource.data.capacity is number
        && reasonableSize();
      // Driver can update their own vehicle (e.g. set active status).
      // Admin can update any vehicle.
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.driverId == request.auth.uid
          && ownerFieldUnchanged("driverId")
          && ownerFieldUnchanged("numberPlate"));
      allow delete: if isAdmin();
    }

    // ─── Driver profiles ───────────────────────────────────────────────
    //
    // IMPORTANT: seat counts, wallet balances and ratings are owned by the
    // backend now. A driver may keep their own contact, vehicle and payout
    // details up to date, but can no longer write themselves extra seats.

    match /drivers/{driverId} {
      // Read: signed-in users can read driver profiles.
      allow read: if signedIn();

      // Create: only the driver themselves can create their own profile.
      allow create: if isOwner(driverId)
        && fieldExists("userId")
        && request.resource.data.userId == driverId
        && reasonableSize();

      // Update: admin can fix anything; the driver can only touch the
      // fields listed below.
      allow update: if isAdmin()
        || (isOwner(driverId)
          && ownerFieldUnchanged("userId")
          && ownerFieldUnchanged("licenseNumber")
          && ownerFieldUnchanged("availableSeats")
          && ownerFieldUnchanged("rating")
          && ownerFieldUnchanged("walletBalancePesewas")
          && ownerFieldUnchanged("pendingEarningsPesewas")
          && ownerFieldUnchanged("payoutHoldPesewas")
          && ownerFieldUnchanged("lifetimeEarningsPesewas")
          && ownerFieldUnchanged("recipientCode")
          && changedKeysWithin([
            "name", "email", "phone", "photoURL", "updatedAt",
            "vehicleId", "vehicleRegistration", "vehicleColor", "vehicleCapacity",
            "routeId", "preferredRoute", "defaultRouteId",
            "momoProvider", "momoNumber",
            "online", "status",
            "currentLocation", "heading", "locationUpdatedAt"
          ])
          && reasonableSize());

      allow delete: if isAdmin();
    }

    // ─── Passenger profiles ────────────────────────────────────────────

    match /passengers/{passengerId} {
      allow create: if isOwner(passengerId)
        && reasonableSize();
      allow read: if isOwner(passengerId) || isAdmin();
      allow update: if isOwner(passengerId) || isAdmin();
      allow delete: if false;
    }

    // ─── Trips ─────────────────────────────────────────────────────────

    match /trips/{tripId} {
      allow read: if signedIn();

      // Create: driver can only create trips for themselves.
      allow create: if signedIn()
        && request.resource.data.driverId == request.auth.uid
        && fieldExists("routeId")
        && fieldExists("status")
        && reasonableSize();

      // Update: driver can update their own trips; admin can update any.
      // The driverId and routeId cannot be changed after creation.
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.driverId == request.auth.uid
          && ownerFieldUnchanged("driverId")
          && ownerFieldUnchanged("routeId")
          && reasonableSize());

      allow delete: if isAdmin();
    }

    // ─── Bookings ──────────────────────────────────────────────────────
    //
    // Backend-only writes. Seats, fares, payment state and cancellation now
    // belong to the payment backend, so a passenger can no longer create a
    // booking with their own price, mark one paid, or release seats.
    // Passengers keep read access (their history) and delete (clear history).

    match /bookings/{bookingId} {
      // `mateId` is written by the backend while a mate is assigned to that
      // booking's trip, and cleared when they come off it. It grants read
      // access to exactly one booking's worth of information — never any
      // authority, which is always re-resolved on the server.
      allow read: if signedIn()
        && (resource.data.passengerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || resource.data.mateId == request.auth.uid
          || isAdmin());

      allow create, update: if false;

      // Delete: the passenger who booked can remove it from their history;
      // admins can delete any booking.
      allow delete: if isAdmin()
        || resource.data.passengerId == request.auth.uid;
    }

    // ─── Ratings ───────────────────────────────────────────────────────
    //
    // Submitted through the backend, which also recomputes the driver average.

    match /ratings/{ratingId} {
      // Read: any signed-in user (driver averages are public info).
      allow read: if signedIn();

      allow create, update, delete: if false;
    }

    // ─── Driver locations (privacy-sensitive) ──────────────────────────

    match /driverLocations/{uid} {
      // Only the driver themselves can write their location.
      allow write: if isOwner(uid);

      // Read access: the driver themselves, OR any signed-in user.
      // The service layer filters which driver locations are exposed.
      allow read: if signedIn();
    }

    // ─── Payments (backend-only) ───────────────────────────────────────
    //
    // The backend uses a service account and bypasses these rules entirely
    // (which is why they can be this strict). Passengers never need to read
    // these documents: the booking carries everything the UI shows.

    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Webhook event ledger (backend-only) ───────────────────────────

    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    // ─── Audit log ─────────────────────────────────────────────────────

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Driver wallet ledger ──────────────────────────────────────────

    match /driverLedger/{entryId} {
      allow read: if signedIn()
        && (resource.data.driverId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ─── Payouts ───────────────────────────────────────────────────────

    match /payouts/{payoutId} {
      allow read: if signedIn()
        && (resource.data.driverId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ─── In-app notifications ──────────────────────────────────────────

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && (resource.data.recipientId == request.auth.uid || isAdmin());
      // The recipient may only mark it read — never edit or forge the content.
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && changedKeysWithin(["read"]);
      allow create, delete: if isAdmin();
    }

    // ─── Mate identities ───────────────────────────────────────────────
    //
    // A mate profile belongs to the mate: their name, contact and Mate ID.
    // Created and updated by the backend only, so a Mate ID can never be
    // invented or replaced from a phone. The driver they work with does not
    // need to read this document — names and codes they must see are
    // embedded on the connection and trip documents instead.

    match /mates/{mateId} {
      allow read: if isOwner(mateId) || isAdmin();
      allow create, update, delete: if false;
    }

    // ─── Driver ↔ mate connections ─────────────────────────────────────
    //
    // "This mate is allowed to work with this driver." Readable by the two
    // people involved so the app can list them; written only by the backend,
    // because accepting a mate is a driver decision the server must verify.

    match /mateConnections/{connectionId} {
      allow read: if signedIn()
        && (resource.data.mateId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || isAdmin());
      allow write: if false;
    }

    // ─── Mate join requests ────────────────────────────────────────────

    match /mateJoinRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.mateId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || isAdmin());
      allow write: if false;
    }

    // ─── Public ID ledger ──────────────────────────────────────────────
    //
    // Maps a Driver/Mate ID to its profile. Backend-only: the app never
    // resolves a code itself, it asks the backend (which also enforces the
    // rate limits), so this mapping never needs to leave the server.

    match /idCodes/{code} {
      allow read, write: if false;
    }

    // ─── Everything else is closed ─────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
