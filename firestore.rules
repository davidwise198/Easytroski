rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {
      allow create, read, update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    match /routes/{routeId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        || (signedIn() && request.resource.data.driverId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read: if signedIn();
      allow create, update: if isOwner(driverId) || isAdmin();
      allow delete: if false;
    }

    match /passengers/{passengerId} {
      allow read, create, update: if isOwner(passengerId) || isAdmin();
      allow delete: if false;
    }

    match /trips/{tripId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && (request.resource.data.driverId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if signedIn()
        && (resource.data.passengerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || isAdmin());
      allow create: if signedIn()
        && request.resource.data.passengerId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.passengerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || isAdmin());
      allow delete: if false;
    }
  }
}
